<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A12">

    <!-- ===== 1. الهيدر - اسم التطبيق ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ NOVA CUT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF7A00" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  PRO"
            android:textSize="12sp"
            android:textColor="#A855F7"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تصدير 4K ↗"
            android:textColor="#FFFFFF"
            android:background="#FF7A00"
            android:padding="8dp" />
    </LinearLayout>

    <!-- ===== 2. معاينة الفيديو ===== -->
    <FrameLayout
        android:id="@+id/videoPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎬 اضغط + لاختيار فيديو\nوابدأ الابداع"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center" />

        <!-- هنا راح يطلع الفيديو -->
        <!-- تأثير NOVA CINEMA راح يشتغل هنا -->

    </FrameLayout>

    <!-- ===== 3. Timeline - مثل برامج الكمبيوتر ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#15151F">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIMELINE  •  فيديو  •  صوت  •  نص"
                android:textColor="#888888"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <View android:layout_width="120dp" android:layout_height="match_parent" android:background="#FF7A00" />
                <View android:layout_width="8dp" android:layout_height="match_parent" />
                <View android:layout_width="120dp" android:layout_height="match_parent" android:background="#A855F7" />
                <View android:layout_width="8dp" android:layout_height="match_parent" />
                <View android:layout_width="120dp" android:layout_height="match_parent" android:background="#00D4FF" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 4. شريط التأثيرات - 100+ تأثير ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  ✨ تأثيرات NOVA - اسحب وشوف الكل"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="6dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="🔥\nNOVA" android:gravity="center" android:textColor="#FFF" android:background="#FF7A00" />
            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="📺\nVHS" android:gravity="center" android:textColor="#FFF" android:layout_marginLeft="8dp" android:background="#333333" />
            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="⚡\nGlitch" android:gravity="center" android:textColor="#FFF" android:layout_marginLeft="8dp" android:background="#333333" />
            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="💜\nNeon" android:gravity="center" android:textColor="#FFF" android:layout_marginLeft="8dp" android:background="#333333" />
            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="🌧️\nمطر" android:gravity="center" android:textColor="#FFF" android:layout_marginLeft="8dp" android:background="#333333" />
            <TextView android:layout_width="70dp" android:layout_height="match_parent" android:text="🔥\nنار" android:gravity="center" android:textColor="#FFF" android:layout_marginLeft="8dp" android:background="#333333" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 5. ازرار الادوات السفلية ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#15151F"
        android:gravity="center">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="✂️\nقص" android:gravity="center" android:textColor="#FFF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔤\nنص" android:gravity="center" android:textColor="#FFF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎵\nموسيقى" android:gravity="center" android:textColor="#FFF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎨\nفلتر" android:gravity="center" android:textColor="#FFF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⏩\nسرعة" android:gravity="center" android:textColor="#FFF" />

    </LinearLayout>

</LinearLayout>
